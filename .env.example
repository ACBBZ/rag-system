# PostgreSQL connection used for tenant metadata, users, ACLs, documents, and audit records.
POSTGRES_DSN=postgresql+asyncpg://rag:rag@localhost:5432/rag

# MinIO/S3-compatible object storage for original files and parsed document content.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniopass
MINIO_BUCKET=rag-system
# Set to true when MINIO_ENDPOINT is served over HTTPS.
MINIO_SECURE=false

# Milvus server used to store and search document chunk vectors.
MILVUS_URI=http://localhost:19530
# Prefix for server-generated tenant aliases and versioned physical collections.
# Tenant names and slugs are never included in generated Milvus names.
MILVUS_COLLECTION_PREFIX=rag_dev
# Existing shared collection used only for tenants that have not been migrated yet.
MILVUS_LEGACY_COLLECTION=rag_chunks
# Deprecated compatibility setting. It is used only when MILVUS_LEGACY_COLLECTION is empty.
MILVUS_COLLECTION=rag_chunks
# Schema and index template applied when provisioning a new tenant collection.
# MILVUS_VECTOR_DIMENSION must exactly match the configured embedding model output.
MILVUS_SCHEMA_VERSION=1
MILVUS_VECTOR_DIMENSION=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_INDEX_M=16
MILVUS_INDEX_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
# Number of rows copied per batch when migrating a tenant from the shared collection.
MILVUS_MIGRATION_BATCH_SIZE=500

# Server-side HMAC secret used to hash the secret portion of tenant API keys.
# Generate a long random value (at least 32 random bytes), keep it in a secret manager,
# and never commit the real value. It must remain stable: changing it invalidates all
# existing V2 API keys because their stored hashes can no longer be verified.
API_KEY_PEPPER=replace-with-a-long-random-secret

# Independent control-plane Bearer token for /v1/platform/* APIs, including tenant creation.
# It is not a tenant user API key and must not be given to tenant owners or applications.
# Generate a separate long random value and store/rotate it as a high-privilege secret.
PLATFORM_API_KEY=replace-with-a-separate-platform-admin-key

# Embedding service used to turn document chunks and queries into vectors.
EMBEDDING_URL=http://localhost:8000/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=replace-me

# Optional reranking service used to reorder retrieved candidates.
RERANK_URL=http://localhost:8000/v1/rerank
RERANK_MODEL=bge-reranker
RERANK_API_KEY=replace-me

# Optional query-rewrite model endpoint.
QUERY_REWRITE_URL=http://localhost:8000/v1/chat/completions
QUERY_REWRITE_MODEL=query-rewrite
QUERY_REWRITE_API_KEY=replace-me

# Answer-generation language model endpoint.
LLM_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=answer-model
LLM_API_KEY=replace-me

# Optional OCR endpoint for scanned or image-based documents.
OCR_URL=http://localhost:8000/v1/ocr
OCR_MODEL=ocr-model
OCR_API_KEY=replace-me

# Default retrieval feature switches. Individual request options may override these defaults.
DEFAULT_QUERY_REWRITE_ENABLED=false
DEFAULT_VECTOR_SEARCH_ENABLED=true
DEFAULT_FULL_TEXT_SEARCH_ENABLED=false
DEFAULT_HYBRID_SEARCH_ENABLED=false
DEFAULT_RERANK_ENABLED=false
DEFAULT_AGENT_SEARCH_ENABLED=false
